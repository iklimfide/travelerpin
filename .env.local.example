NEXT_PUBLIC_SITE_URL=https://travelerpin.com
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Cloudflare R2 — city/park photos (public bucket or custom domain)
R2_ACCOUNT_ID=your-cloudflare-account-id
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_BUCKET_NAME=travelerpin-media
# Public base URL, e.g. https://pub-xxxx.r2.dev or https://media.travelerpin.com
R2_PUBLIC_BASE_URL=https://pub-xxxx.r2.dev

# Optional — enables Instagram thumbnail caching in the database via Meta oEmbed
# META_APP_ID=your-meta-app-id
# META_APP_SECRET=your-meta-app-secret
